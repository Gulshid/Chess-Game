rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      // Anyone signed in can read any profile (leaderboard, opponent
      // display in matchmaking) — only the owner can write their own.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;

      match /saved_games/{gameId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Online chess games. Both players (white and black) need to be able
    // to read the doc and write moves/status to it, so this can't be
    // scoped to a single uid the way /users/{uid} is.
    match /games/{gameId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.whiteUid == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.whiteUid == request.auth.uid
            || resource.data.blackUid == request.auth.uid);

      // Only the creator can delete, and only while still waiting for an
      // opponent (matches leaveGame()'s "safe to delete" case).
      allow delete: if request.auth != null
        && resource.data.whiteUid == request.auth.uid
        && resource.data.status == 'waitingForOpponent';
    }

    // 6-letter invite codes -> gameId lookup for private games.
    match /game_codes/{code} {
      // list is needed for findCodeForGame()'s where('gameId', ...) query
      // right after creating a private game.
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Quick-match ticket queue. A ticket must be claimable (status flipped
    // to "matched") by the *other* client, not just its own creator, so
    // update access is intentionally broader than create/delete.
    match /matchmaking_queue/{ticketId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      allow update: if request.auth != null;

      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

  }
}
